export const snapshot = {};

snapshot[`zero-argument root reuses concise usage navigation 1`] = `
"linear — Handy linear commands from the command line.

commands:
  auth                           Manage Linear authentication
  issue, i                       Manage Linear issues
  team, t                        Manage Linear teams
  user, u                        Manage Linear users
  project, p                     Manage Linear projects
  project-update, pu             Manage project status updates
  cycle, cy                      Manage Linear team cycles
  milestone, m                   Manage Linear project milestones
  initiative, init               Manage Linear initiatives
  initiative-update, iu          Manage initiative status updates (timeline posts)
  label, l                       Manage Linear issue labels
  document, docs, doc            Manage Linear documents
  guide [name] [options]         Read bundled workflow guides [json]
  recipe [name] [options]        Read bundled workflow examples and script source [json]
  completions                    Generate shell completions.
  config, configure              Interactively generate .linear.toml configuration [writes; interactive]
  schema [options]               Print the GraphQL schema to stdout [json]
  api [document] [options]       Run raw GraphQL queries or explicitly unprotected mutations. [writes; json]
  upload <paths...> [options]    Upload files to Linear storage and print their asset URLs for embedding in Markdown [writes; json]
  download <assetUrl> [options]  Download a Linear asset and verify its SHA-256 [json]
  update [options]               Update the Linear CLI [writes]
  version [options]              Show the CLI distribution and build version [json]

global options:
  -h, --help          Show this help.
  --workspace <slug>  Target workspace (uses credentials)
  -j, --json          Output JSON where supported

detail: linear <domain> usage; linear <command> --help
machine-readable: linear usage --json
workflows: linear guide; examples: linear recipe
"
`;

