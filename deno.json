{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "version": "0.0.0-dev",
  "exports": "./src/main.ts",
  "license": "ISC",
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "tasks": {
    "dev": "deno task generate-graphql-types && deno run --allow-all --quiet src/main.ts ",
    "install": "deno task generate-graphql-types && deno install --compile --frozen --lock=./deno.lock -c ./deno.json --allow-all --quiet -g -f -n linear ./src/main.ts",
    "uninstall": "deno uninstall -g linear",
    "generate-graphql-types": "deno run --allow-all npm:@graphql-codegen/cli@7.2.0/graphql-codegen-esm",
    "sync-graphql-schema": "deno task dev schema -o graphql/schema.graphql && deno task generate-graphql-types",
    "generate-skill-docs": "deno task generate-graphql-types && deno run --allow-run --allow-read --allow-write .agents/skills/linear-cli/scripts/generate-docs.ts",
    "check-types": "deno check src/main.ts",
    "test": "deno test --allow-all --quiet",
    "update-snapshots": "deno test --allow-all -- --update",
    "evaluate-skill": "deno run --allow-all evals/linear-cli-skill/run.ts",
    "verify-source": "deno task generate-graphql-types && deno fmt --check && deno lint && deno task check-types && deno task test --ignore=test/keyring.integration.test.ts",
    "verify-skill-docs": "deno task generate-skill-docs --check",
    "verify-release": "NO_COLOR=1 deno task verify-source && deno task verify-skill-docs"
  },
  "imports": {
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1.2.1",
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@cliffy/internal": "jsr:@cliffy/internal@^1.2.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@cliffy/testing": "jsr:@cliffy/testing@^1.2.1",
    "@graphql-codegen/cli": "npm:@graphql-codegen/cli@^7.2.0",
    "@graphql-typed-document-node/core": "npm:@graphql-typed-document-node/core@^3.2.0",
    "@littletof/charmd": "jsr:@littletof/charmd@^0.1.2",
    "@opensrc/deno-open": "jsr:@opensrc/deno-open@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "mdast": "npm:@types/mdast@^4.0.4",
    "graphql": "npm:graphql@^17.0.2",
    "./__generated__/graphql": "./src/__codegen__/graphql.ts",
    "graphql-request": "npm:graphql-request@^7.4.0",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "remark-parse": "npm:remark-parse@^11.0.0",
    "remark-stringify": "npm:remark-stringify@^11.0.0",
    "sanitize-filename": "npm:sanitize-filename@^1.6.4",
    "unified": "npm:unified@^11.0.5",
    "unist-util-visit": "npm:unist-util-visit@^5.1.0",
    "valibot": "npm:valibot@^1.4.2"
  },
  "fmt": {
    "exclude": [
      "__generated__/",
      "src/__codegen__/"
    ],
    "proseWrap": "never",
    "semiColons": false
  },
  "lint": {
    "exclude": [
      "__generated__/",
      "src/__codegen__/"
    ]
  },
  "unstable": [
    "sloppy-imports"
  ]
}
