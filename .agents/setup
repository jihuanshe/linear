#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
deno_version="2.7.9"
tool_root="$HOME/.local/share/amp/jihuanshe-linear"
repo_id="$(printf '%s' "$repo_root" | sha256sum | cut -c1-16)"
checkout_root="$tool_root/checkouts/$repo_id"
bin_dir="$checkout_root/bin"
install_dir="$tool_root/deno/$deno_version"
deno_bin="$install_dir/deno"

if [[ ! -x "$deno_bin" ]]; then
  echo "Installing Deno $deno_version"
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT
  curl -fsSL \
    "https://github.com/denoland/deno/releases/download/v${deno_version}/deno-x86_64-unknown-linux-gnu.zip" \
    -o "$tmp_dir/deno.zip"
  unzip -q "$tmp_dir/deno.zip" -d "$tmp_dir"
  mkdir -p "$install_dir"
  install -m 0755 "$tmp_dir/deno" "$deno_bin"
fi

mkdir -p "$bin_dir"
rm -f "$bin_dir/deno"
cat > "$bin_dir/deno" <<EOF
#!/usr/bin/env bash
set -euo pipefail

# Deno treats FORCE_COLOR as enabled whenever it exists, including when its
# value is "0". Preserve an explicit opt-in while honoring environments that
# use FORCE_COLOR=0 to request machine-clean output.
if [[ "\${FORCE_COLOR-}" == "0" ]]; then
  unset FORCE_COLOR
fi

exec "$deno_bin" "\$@"
EOF
chmod 0755 "$bin_dir/deno"
export PATH="$bin_dir:$PATH"

profile_file=""
for candidate in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
  if [[ -e "$candidate" ]]; then
    profile_file="$candidate"
    break
  fi
done
profile_file="${profile_file:-$HOME/.bash_profile}"
profile_marker="# jihuanshe/linear orb toolchain ($repo_root -> $bin_dir)"
if ! grep -Fqx "$profile_marker" "$profile_file" 2>/dev/null; then
  cat >> "$profile_file" <<EOF

$profile_marker
case "\$PWD/" in
  "$repo_root/"*)
    case ":\$PATH:" in
      *":$bin_dir:"*) ;;
      *) export PATH="$bin_dir:\$PATH" ;;
    esac
    ;;
esac
EOF
fi

echo "Caching locked dependencies"
cd "$repo_root"
"$bin_dir/deno" install --frozen --quiet

echo "Installing linear CLI from this checkout"
DENO_INSTALL_ROOT="$checkout_root" "$bin_dir/deno" task install

echo "Deno $deno_version is ready"
