#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
tool_root="$HOME/.local/share/amp/jihuanshe-linear"
bin_dir="$tool_root/bin"

if [[ "${AMP_ORB-}" != "1" ]]; then
  echo "This lifecycle script is supported only inside an Amp Orb" >&2
  exit 1
fi

expected_repo_root="$(cd "$HOME/workspace/repo" && pwd -P)"
if [[ "$repo_root" != "$expected_repo_root" ]]; then
  echo "Orb toolchain setup supports only the primary checkout: $expected_repo_root" >&2
  exit 1
fi

mise_bin="$(command -v mise || true)"
if [[ -z "$mise_bin" ]]; then
  mise_bin="$HOME/.local/bin/mise"
  if [[ ! -e "$mise_bin" && ! -L "$mise_bin" ]]; then
    curl -fsSL https://mise.run | sh
  fi
fi

"$mise_bin" trust "$repo_root/mise.toml"
"$mise_bin" -C "$repo_root" install --locked deno node npm:markdownlint-cli2 github:huacnlee/autocorrect prek
"$repo_root/.agents/resume"

echo "Caching locked dependencies"
cd "$repo_root"
"$bin_dir/deno" install --frozen --quiet

echo "Generating GraphQL types"
"$bin_dir/deno" task generate-graphql-types

"$mise_bin" -C "$repo_root" run hooks:install
echo "The pinned toolchain, pre-commit checks and linear source wrapper are ready"
