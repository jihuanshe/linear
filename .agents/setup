#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
deno_version="2.7.9"
install_dir="$HOME/.local/share/deno/$deno_version"
deno_bin="$install_dir/deno"

if [[ ! -x "$deno_bin" ]]; then
  echo "Installing Deno $deno_version"
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT
  curl -fsSL \
    "https://github.com/denoland/deno/releases/download/v${deno_version}/deno-x86_64-unknown-linux-gnu.zip" \
    -o "$tmp_dir/deno.zip"
  unzip -q "$tmp_dir/deno.zip" -d "$tmp_dir"
  mkdir -p "$install_dir"
  install -m 0755 "$tmp_dir/deno" "$deno_bin"
fi

mkdir -p "$HOME/.local/bin"
ln -sfn "$deno_bin" "$HOME/.local/bin/deno"
export PATH="$HOME/.local/bin:$PATH"

echo "Installing linear CLI from this checkout"
cd "$repo_root"
DENO_INSTALL_ROOT="$HOME/.local" "$deno_bin" task install

echo "Deno $deno_version is ready"
