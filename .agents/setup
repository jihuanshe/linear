#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
tool_root="$HOME/.local/share/amp/jihuanshe-linear"
bin_dir="$tool_root/bin"
path_bin_dir="$HOME/.local/bin"

if [[ "${AMP_ORB-}" != "1" ]]; then
  echo "This lifecycle script is supported only inside an Amp Orb" >&2
  exit 1
fi

expected_repo_root="$(cd "$HOME/workspace/repo" && pwd -P)"
if [[ "$repo_root" != "$expected_repo_root" ]]; then
  echo "Orb toolchain setup supports only the primary checkout: $expected_repo_root" >&2
  exit 1
fi

# .agents/resume resolves mise, deno and linear through PATH, and the mise
# installer writes to this directory. Fail before downloading anything instead
# of finishing the install and then reporting mise as missing.
if [[ ":$PATH:" != *":$path_bin_dir:"* ]]; then
  echo "$path_bin_dir is not on PATH; add it before rerunning .agents/setup" >&2
  exit 1
fi

mise_bin="$(command -v mise || true)"
if [[ -z "$mise_bin" ]]; then
  mise_bin="$path_bin_dir/mise"
  if [[ ! -e "$mise_bin" && ! -L "$mise_bin" ]]; then
    curl -fsSL https://mise.run | sh
  fi
fi

# mise evaluates min_version before running project-scoped commands. Upgrade
# first so an existing Orb with the previous mise can recover this checkout.
if ! MISE_CONFIG_FILE=/dev/null "$mise_bin" self-update -y --no-plugins >/dev/null 2>&1; then
  # Distribution-packaged mise builds may disable self-update. The official
  # installer is the recovery path in that case and writes to path_bin_dir.
  curl -fsSL https://mise.run | sh
  mise_bin="$path_bin_dir/mise"
fi

"$mise_bin" trust "$repo_root/mise.toml"
"$mise_bin" -C "$repo_root" install --locked deno node npm:markdownlint-cli2 github:huacnlee/autocorrect prek
"$repo_root/.agents/resume"

echo "Caching locked dependencies"
cd "$repo_root"
"$bin_dir/deno" install --frozen --quiet

echo "Generating GraphQL types"
"$bin_dir/deno" task generate-graphql-types

echo "The pinned toolchain, pre-commit checks and linear source wrapper are ready"
