project favorite add writes only when the project is not yet a favorite and accepts the project's name, slug ID, UUID or URL; list shows only the viewer's project favorites, and remove deletes only an existing favorite.
-- seed.json --
{"Project": [{"id": "1e000000-0000-4000-8000-000000000001", "name": "Roadmap", "slugId": "a1b2c3d4e5f6", "url": "https://linear.app/kadoraba/project/roadmap-a1b2c3d4e5f6"}],
 "Issue": [{"id": "1a000000-0000-4000-8000-000000000123", "identifier": "ENG-123", "title": "Feedback"}],
 "Favorite": [{"id": "1f100000-0000-4000-8000-000000000001", "type": "issue", "owner": "0b000000-0000-4000-8000-000000000001", "issue": "1a000000-0000-4000-8000-000000000123", "parent": null}]}
-- run --
linear project favorite add Roadmap --json
-- stdout.json --
{
  "ok": true,
  "effect": "applied",
  "data": {
    "project": {
      "id": "1e000000-0000-4000-8000-000000000001",
      "slugId": "a1b2c3d4e5f6",
      "name": "Roadmap",
      "favorite": null
    },
    "favorite": {
      "id": "{{=FAV}}",
      "type": "project",
      "title": "Roadmap",
      "url": "https://linear.app/kadoraba/project/roadmap-a1b2c3d4e5f6",
      "folderName": null,
      "parent": null,
      "project": {
        "id": "1e000000-0000-4000-8000-000000000001",
        "slugId": "a1b2c3d4e5f6",
        "name": "Roadmap"
      }
    }
  }
}
-- mutations.json --
{"favoriteCreate": 1}
-- state.json --
{"Favorite": [{"type": "issue"}, {"type": "project", "project": "1e000000-0000-4000-8000-000000000001", "parent": null}]}
