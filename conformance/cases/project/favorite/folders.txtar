project favorite add --folder places the project in an existing folder; a conflicting folder for an existing favorite, a missing folder and an ambiguous folder name are rejected before any write.
-- seed.json --
{"Project": [{"id": "1e000000-0000-4000-8000-000000000001", "name": "Roadmap", "slugId": "a1b2c3d4e5f6", "url": "https://linear.app/kadoraba/project/roadmap-a1b2c3d4e5f6"}, {"id": "1e000000-0000-4000-8000-000000000002", "name": "Other", "slugId": "b1b2c3d4e5f6", "url": "https://linear.app/kadoraba/project/other-b1b2c3d4e5f6"}],
 "Favorite": [
  {"id": "1f100000-0000-4000-8000-000000000001", "type": "folder", "folderName": "Inbox", "owner": "0b000000-0000-4000-8000-000000000001", "issue": null, "parent": null},
  {"id": "1f100000-0000-4000-8000-000000000002", "type": "folder", "folderName": "Later", "owner": "0b000000-0000-4000-8000-000000000001", "issue": null, "parent": null},
  {"id": "1f100000-0000-4000-8000-000000000003", "type": "folder", "folderName": "Later", "owner": "0b000000-0000-4000-8000-000000000001", "issue": null, "parent": null}]}
-- run --
linear project favorite add Roadmap --folder Inbox --json
