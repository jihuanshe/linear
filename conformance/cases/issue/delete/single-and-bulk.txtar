delete trashes one issue by UUID or by an identifier from before a team move, or several in bulk.
-- seed.json --
{"Issue": [{"id": "11111111-1111-4111-8111-111111111111", "identifier": "ENG-42", "title": "Moved issue", "previousIdentifiers": ["OLD-123"]}, {"id": "22222222-2222-4222-8222-222222222222", "identifier": "ENG-43", "title": "Second"}, {"id": "33333333-3333-4333-8333-333333333333", "identifier": "ENG-44", "title": "Third"}]}
-- run --
linear issue delete 11111111-1111-4111-8111-111111111111 --yes
-- stdout --
✓ Successfully deleted issue: ENG-42: Moved issue
-- state.json --
{"Issue": [{"identifier": "ENG-42", "trashed": true}, {"identifier": "ENG-43", "trashed": null}, {"identifier": "ENG-44", "trashed": null}]}
-- run --
linear issue delete --yes --bulk 22222222-2222-4222-8222-222222222222
-- stdout --

✓ Successfully deleted 1 issue
-- stderr --
Found 1 issue(s) to delete.
-- state.json --
{"Issue": [{"identifier": "ENG-42"}, {"identifier": "ENG-43", "trashed": true}, {"identifier": "ENG-44", "trashed": null}]}
-- run --
linear issue delete OLD-123 --yes --json
-- stdout.json --
{
  "ok": true,
  "effect": "applied",
  "data": {
    "success": true,
    "entity": {
      "id": "11111111-1111-4111-8111-111111111111",
      "identifier": "ENG-42",
      "title": "Moved issue"
    }
  }
}
-- mutations.json --
{"issueDelete": 1}
