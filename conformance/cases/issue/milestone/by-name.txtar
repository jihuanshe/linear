A milestone name resolves in the issue's project; with an explicit --project it resolves there and moves the issue; a milestone UUID needs no project.
-- seed.json --
{"Project": [{"id": "1e000000-0000-4000-8000-000000000001", "name": "Alpha", "slugId": "a1b2c3d4e5f6", "teams": ["0c000000-0000-4000-8000-000000000001"]},
  {"id": "1e000000-0000-4000-8000-000000000002", "name": "Beta", "slugId": "b1b2c3d4e5f6", "teams": ["0c000000-0000-4000-8000-000000000001"]}],
 "ProjectMilestone": [{"id": "1f000000-0000-4000-8000-000000000001", "name": "Launch", "project": "1e000000-0000-4000-8000-000000000001"},
  {"id": "1f000000-0000-4000-8000-000000000002", "name": "Launch", "project": "1e000000-0000-4000-8000-000000000002"},
  {"id": "1f000000-0000-4000-8000-000000000003", "name": "Beta only", "project": "1e000000-0000-4000-8000-000000000002"}],
 "Issue": [{"id": "1a000000-0000-4000-8000-000000000123", "identifier": "ENG-123", "title": "Milestoned", "project": "1e000000-0000-4000-8000-000000000001"}]}
-- run --
linear issue update ENG-123 --unprotected --milestone Launch --json > alpha.json
-- state.json --
{"Issue": [{"identifier": "ENG-123", "project": "1e000000-0000-4000-8000-000000000001", "projectMilestone": "1f000000-0000-4000-8000-000000000001"}]}
-- run --
linear issue update ENG-123 --unprotected --project Beta --milestone Launch --json > beta.json
-- state.json --
{"Issue": [{"identifier": "ENG-123", "project": "1e000000-0000-4000-8000-000000000002", "projectMilestone": "1f000000-0000-4000-8000-000000000002"}]}
-- run --
linear issue update ENG-123 --unprotected --milestone 1f000000-0000-4000-8000-000000000003 --json > uuid.json
-- state.json --
{"Issue": [{"identifier": "ENG-123", "project": "1e000000-0000-4000-8000-000000000002", "projectMilestone": "1f000000-0000-4000-8000-000000000003"}]}
