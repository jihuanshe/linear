A relation receipt with success false leaves the effect unknown; a confirmed receipt whose endpoints are reversed is reported as applied but not accepted.
-- seed.json --
{"Issue": [{"id": "1a000000-0000-4000-8000-000000000001", "identifier": "ENG-1", "title": "Source"}, {"id": "1a000000-0000-4000-8000-000000000002", "identifier": "ENG-2", "title": "Target"}]}
-- faults.json --
[{"on": "mutation:issueRelationCreate", "action": "status", "status": 200, "body": {"data": {"issueRelationCreate": {"success": false, "issueRelation": null}}}}]
-- run --
linear issue relation add ENG-1 related ENG-2 --json
-- stdout.json --
{
  "ok": false,
  "effect": "unknown",
  "data": {
    "issueRelationCreate": {
      "success": false,
      "issueRelation": null
    }
  },
  "error": {
    "code": "WriteError",
    "message": "Failed to create relation: Mutation was not confirmed",
    "suggestion": "Reconcile the remote outcome before retrying this write."
  }
}
-- exit --
1
