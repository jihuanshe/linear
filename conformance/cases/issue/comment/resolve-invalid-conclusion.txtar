{
  "ok": false,
  "effect": "none",
  "error": {
    "code": "ValidationError",
    "message": "Failed to resolve comment: Resolving comment must be a reply in this thread",
    "suggestion": "Use an existing conclusion reply, or create one with 'linear issue comment add 1a000000-0000-4000-8000-000000000001 --parent abcdefab-1234-4567-89ab-abcdefabcdef --body-file conclusion.md --json' using the same --workspace selection. After a successful exit, use data.comment.id from that result as --resolving-comment; do not create another root comment."
  }
}
-- exit --
1
