{"Issue": [{"id": "1a000000-0000-4000-8000-000000000001", "identifier": "ENG-1", "title": "Thread"}, {"id": "1a000000-0000-4000-8000-000000000002", "identifier": "ENG-2", "title": "Elsewhere"}],
 "Comment": [
  {"id": "abcdefab-1234-4567-89ab-abcdefabcdef", "issue": "1a000000-0000-4000-8000-000000000001", "body": "Root"},
  {"id": "fedcbafe-1234-4567-89ab-fedcbafedcba", "issue": "1a000000-0000-4000-8000-000000000001", "parent": "abcdefab-1234-4567-89ab-abcdefabcdef", "body": "Conclusion"},
  {"id": "1c000000-0000-4000-8000-000000000003", "issue": "1a000000-0000-4000-8000-000000000001", "parent": "abcdefab-1234-4567-89ab-abcdefabcdef", "body": "Another reply"},
  {"id": "1c000000-0000-4000-8000-000000000009", "issue": "1a000000-0000-4000-8000-000000000002", "body": "Other issue"}]}
-- run --
linear issue comment resolve abcdefab-1234-4567-89ab-abcdefabcdef --resolving-comment abcdefab-1234-4567-89ab-abcdefabcdef --json
