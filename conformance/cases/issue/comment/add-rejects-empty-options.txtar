Explicitly empty comment options are rejected before any request, in JSON and human output.
-- file body.md --
body
-- file valid.png --
pretend png
-- run --
linear issue comment add ENG-123 --body '' --json
-- stdout.json --
{
  "ok": false,
  "effect": "none",
  "error": {
    "code": "ValidationError",
    "message": "Failed to add comment: Comment body cannot be empty"
  }
}
-- exit --
1
-- no-requests --
-- run --
linear issue comment add ENG-123 --body ' ' --json
-- stdout.json --
{
  "ok": false,
  "effect": "none",
  "error": {
    "code": "ValidationError",
    "message": "Failed to add comment: Comment body cannot be empty"
  }
}
-- exit --
1
