comment update replaces the body when the original still matches, through --body, --body-file or an editor; explicitly empty input and conflicting options are rejected before any request, and empty or whitespace-only content is refused.
-- seed.json --
{"Issue": [{"id": "1a000000-0000-4000-8000-000000000001", "identifier": "ENG-1", "title": "Thread"}],
 "Comment": [{"id": "1c000000-0000-4000-8000-000000000001", "issue": "1a000000-0000-4000-8000-000000000001", "body": "Original body"}]}
-- file body.md --
From a file
-- file empty.md --
-- exec editor --
#!/bin/sh
cp "$1" seen.md
printf '%s' 'Edited body' > "$1"
-- run --
linear issue comment view 1c000000-0000-4000-8000-000000000001 --json > original.json
-- run --
linear issue comment update 1c000000-0000-4000-8000-000000000001 --body "New body" --base-file original.json --json > first.json
-- state.json --
{"Comment": [{"body": "New body", "editedAt": "{{*}}"}]}
-- run --
linear issue comment update 1c000000-0000-4000-8000-000000000001 --body-file body.md --unprotected --json > second.json
