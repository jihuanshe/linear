favorite add --folder places the issue in an existing folder; a conflicting folder for an existing favorite and an ambiguous folder name are rejected; list keeps only issue favorites.
-- seed.json --
{"Issue": [{"id": "1a000000-0000-4000-8000-000000000123", "identifier": "ENG-123", "title": "Feedback"}, {"id": "1a000000-0000-4000-8000-000000000124", "identifier": "ENG-124", "title": "Other"}],
 "Favorite": [
  {"id": "1f100000-0000-4000-8000-000000000001", "type": "folder", "folderName": "Inbox", "owner": "0b000000-0000-4000-8000-000000000001", "issue": null, "parent": null},
  {"id": "1f100000-0000-4000-8000-000000000002", "type": "folder", "folderName": "Later", "owner": "0b000000-0000-4000-8000-000000000001", "issue": null, "parent": null},
  {"id": "1f100000-0000-4000-8000-000000000003", "type": "folder", "folderName": "Later", "owner": "0b000000-0000-4000-8000-000000000001", "issue": null, "parent": null}]}
-- run --
linear issue favorite add ENG-123 --folder Inbox --json
-- stdout.json --
{
  "ok": true,
  "effect": "applied",
