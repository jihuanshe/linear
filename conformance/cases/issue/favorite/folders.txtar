        "folderName": "Inbox"
      },
      "issue": {
        "id": "1a000000-0000-4000-8000-000000000123",
        "identifier": "ENG-123"
      }
    }
  }
}
-- state.json --
{"Favorite": [{"type": "folder"}, {"type": "folder"}, {"type": "folder"}, {"type": "issue", "issue": "1a000000-0000-4000-8000-000000000123", "parent": "1f100000-0000-4000-8000-000000000001"}]}
