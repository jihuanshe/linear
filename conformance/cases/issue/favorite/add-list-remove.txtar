favorite add writes only when the issue is not yet a favorite, list shows the viewer's issue favorites, and remove deletes only an existing favorite.

live: true
-- run --
linear issue create --team {{TEAM}} --title "{{RUN}} favorite" --json
-- stdout.json --
{"ok": true, "effect": "applied", "data": {"success": true, "issue": {"identifier": "{{=ISSUE}}", "...": true}}, "fields": "{{*}}"}
-- stderr --
{{*}}
-- run --
linear issue favorite add {{ISSUE}} --json
-- stdout.json --
{"ok": true, "effect": "applied", "data": {"favorite": {"id": "{{=FAV}}", "type": "issue", "title": "{{RUN}} favorite", "url": "{{*}}", "folderName": null, "...": true}, "...": true}}
-- run --
linear issue favorite add {{ISSUE}} --json
-- stdout.json --
{"ok": true, "effect": "none", "data": {"favorite": {"id": "{{FAV}}", "...": true}, "...": true}}
-- run --
linear issue favorite remove {{ISSUE}} --json
-- stdout.json --
{"ok": true, "effect": "applied", "...": true}
-- run --
linear issue favorite remove {{ISSUE}} --json
-- stdout.json --
{"ok": true, "effect": "none", "...": true}
-- cleanup --
linear issue delete {{ISSUE}} -y
