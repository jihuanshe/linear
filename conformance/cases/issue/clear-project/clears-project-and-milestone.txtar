--clear-project removes the project and its milestone and nothing else, verified by reading back; on an issue without a project it is a no-op.
-- seed.json --
{"User": [{"id": "1b000000-0000-4000-8000-000000000002", "name": "Jane"}],
 "Project": [{"id": "1e000000-0000-4000-8000-000000000001", "name": "Release", "slugId": "r1b2c3d4e5f6", "teams": ["0c000000-0000-4000-8000-000000000001"]}],
 "ProjectMilestone": [{"id": "1f000000-0000-4000-8000-000000000001", "name": "Old milestone", "project": "1e000000-0000-4000-8000-000000000001"}],
 "Issue": [
  {"id": "1a000000-0000-4000-8000-000000001001", "identifier": "ENG-1001", "title": "In project", "project": "1e000000-0000-4000-8000-000000000001", "projectMilestone": "1f000000-0000-4000-8000-000000000001", "assignee": "1b000000-0000-4000-8000-000000000002", "state": "0d000000-0000-4000-8000-000000000002"},
  {"id": "1a000000-0000-4000-8000-000000001002", "identifier": "ENG-1002", "title": "No project"}]}
-- run --
linear issue view ENG-1001 --json > original.json
-- run --
linear issue update ENG-1001 --clear-project --base-file original.json --json
