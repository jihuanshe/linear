-- run --
linear issue update {{ISSUE}} --title "{{RUN}} conflict mine" --base-file original.json --json
-- stdout.json --
{
  "ok": false,
  "effect": "none",
  "error": {
    "code": "ConflictError",
    "message": "Failed to update issue: Original values changed: title",
    "suggestion": "Read the current object and reconsider the change; do not refresh the original file merely to bypass this conflict.",
    "details": {
      "fields": [
        {
          "field": "title",
          "inputField": "title",
          "base": "{{RUN}} conflict original",
          "desired": "{{RUN}} conflict mine",
          "remote": "{{RUN}} conflict concurrent",
          "verdict": "conflict"
        }
      ],
      "dependencies": []
    }
  }
}
-- exit --
1
