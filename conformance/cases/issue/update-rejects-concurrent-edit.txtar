If the issue changed after the original was saved, the protected update writes nothing.

live: true
-- run --
linear issue create --team {{TEAM}} --title "{{RUN}} conflict original" --json
-- stdout.json --
{"ok": true, "effect": "applied", "data": {"success": true, "issue": {"identifier": "{{=ISSUE}}", "...": true}}, "fields": "{{*}}"}
-- stderr --
{{*}}
-- run --
linear issue view {{ISSUE}} --json > original.json
-- run --
linear issue update {{ISSUE}} --title "{{RUN}} conflict concurrent" --unprotected --json
-- stdout.json --
