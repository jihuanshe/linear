An original null description and a remote empty description (or the reverse) differ; when both are null, writing an empty description applies.
-- seed.json --
{"Issue": [
  {"id": "1a000000-0000-4000-8000-000000000001", "identifier": "ENG-1", "title": "Null and null", "description": null},
  {"id": "1a000000-0000-4000-8000-000000000002", "identifier": "ENG-2", "title": "Empty then null", "description": null},
  {"id": "1a000000-0000-4000-8000-000000000003", "identifier": "ENG-3", "title": "Null then empty", "description": ""}]}
-- run --
linear issue view ENG-1 --json > one.json
-- run --
linear issue update ENG-1 --description "" --base-file one.json --json > one-result.json
-- exit --
1
-- mutations.json --
{"issueUpdate": 1}
