An edit made while label names are being resolved is noticed by the final read: the whole mixed update is refused.
-- seed.json --
{"IssueLabel": [{"id": "0e000000-0000-4000-8000-000000000011", "name": "frontend"}],
 "Issue": [{"id": "1a000000-0000-4000-8000-000000000123", "identifier": "ENG-123", "title": "Labels", "description": "Before"}]}
-- run --
linear issue view ENG-123 --json > original.json
-- faults.json --
[{"on": "query", "selects": "issueLabels", "action": "patch-after", "seed": {"Issue": [{"id": "1a000000-0000-4000-8000-000000000123", "description": "Edited during lookup"}]}}]
-- run --
linear issue update ENG-123 --description Desired --add-label frontend --base-file original.json --json
