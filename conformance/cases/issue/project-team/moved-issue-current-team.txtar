For an issue that moved teams, the project check uses its current team, even when addressed by its old identifier.
-- seed.json --
{"Team": [{"id": "0c000000-0000-4000-8000-000000000002", "key": "NEW", "name": "New team"}],
 "WorkflowState": [{"id": "0d000000-0000-4000-8000-000000000021", "team": "0c000000-0000-4000-8000-000000000002", "name": "Backlog", "type": "backlog", "position": 0, "color": "#bec2c8"}],
 "Project": [{"id": "1e000000-0000-4000-8000-000000000001", "name": "Old team project", "slugId": "o1b2c3d4e5f6", "teams": ["0c000000-0000-4000-8000-000000000001"]},
  {"id": "1e000000-0000-4000-8000-000000000002", "name": "New team project", "slugId": "n1b2c3d4e5f6", "teams": ["0c000000-0000-4000-8000-000000000002"]}],
 "Issue": [{"identifier": "NEW-1", "title": "Moved", "team": "0c000000-0000-4000-8000-000000000002", "state": "0d000000-0000-4000-8000-000000000021", "previousIdentifiers": ["ENG-1"]}]}
-- run --
linear issue update --unprotected ENG-1 --project 1e000000-0000-4000-8000-000000000001 --json
