In interactive create, a label that matches no name exactly offers the candidates containing it, sorted by name, including candidates beyond the first page; each such label gets its own prompt.
-- seed.json --
{"IssueLabel": [
  {"id": "0e000000-0000-4000-8000-000000000021", "name": "Partial frontend"},
  {"id": "0e000000-0000-4000-8000-000000000022", "name": "Partial backend", "team": "0c000000-0000-4000-8000-000000000001"},
  {"id": "0e000000-0000-4000-8000-000000000023", "name": "Other one"},
  {"$repeat": 60, "name": "Partial zz filler {{n:2}}"}]}
-- env --
LINEAR_ISSUE_CREATE_ASSIGN_SELF=never
-- tty --
expect Issue label with Partial does not exist
send \r
expect Issue label named Other does not exist, but Other one exists
send \r
-- run --
linear issue create --title Interactive --team ENG --label Partial --label Other
-- stdout --
{{*}}❯ Partial backend
  Partial frontend
  Partial zz filler 01{{*}}✓ Created issue ENG-1: Interactive
{{*}}
-- state.json --
{"Issue": [{"title": "Interactive", "labels": ["0e000000-0000-4000-8000-000000000022", "0e000000-0000-4000-8000-000000000023"]}]}
