A protected update compares the saved original, writes only changed fields once, and reads back.
-- seed.json --
{"Issue": [{"id": "1a000000-0000-4000-8000-000000000001", "identifier": "ENG-7", "number": 7, "team": "0c000000-0000-4000-8000-000000000001", "state": "0d000000-0000-4000-8000-000000000002", "title": "Old title", "description": "Body", "priority": 0, "labels": [], "creator": "0b000000-0000-4000-8000-000000000001", "createdAt": "2025-06-01T00:00:00.000Z", "updatedAt": "2025-06-01T00:00:00.000Z", "archivedAt": null, "trashed": null}]}
-- run --
linear issue view ENG-7 --json > original.json
-- run --
linear issue update ENG-7 --title "New title" --state "In Progress" --base-file original.json --json
