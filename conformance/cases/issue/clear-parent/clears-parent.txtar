--clear-parent moves a sub-issue out of its parent and changes nothing else, verified by reading back; on an issue without a parent it is a no-op.
-- seed.json --
{"Issue": [
  {"id": "1a000000-0000-4000-8000-000000001000", "identifier": "ENG-1000", "title": "Parent"},
  {"id": "1a000000-0000-4000-8000-000000001001", "identifier": "ENG-1001", "title": "Child", "parent": "1a000000-0000-4000-8000-000000001000", "state": "0d000000-0000-4000-8000-000000000002"},
  {"id": "1a000000-0000-4000-8000-000000001002", "identifier": "ENG-1002", "title": "No parent"}]}
-- run --
linear issue view ENG-1001 --json > original.json
-- run --
linear issue update ENG-1001 --clear-parent --base-file original.json --json
