          "inputField": "parentId",
          "base": "1a000000-0000-4000-8000-000000001000",
          "desired": null,
          "remote": "1a000000-0000-4000-8000-000000001003",
          "verdict": "conflict"
        }
      ],
      "dependencies": []
    }
  }
}
