--clear-parent refuses to write when the parent changed since the original read.
-- seed.json --
{"Issue": [
  {"id": "1a000000-0000-4000-8000-000000001000", "identifier": "ENG-1000", "title": "Parent"},
  {"id": "1a000000-0000-4000-8000-000000001003", "identifier": "ENG-1003", "title": "Other parent"},
  {"id": "1a000000-0000-4000-8000-000000001001", "identifier": "ENG-1001", "title": "Child", "parent": "1a000000-0000-4000-8000-000000001000"}]}
-- run --
linear issue view ENG-1001 --json > original.json
-- run --
linear issue update ENG-1001 --unprotected --parent ENG-1003 --json
