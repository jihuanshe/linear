LINEAR_ISSUE_CREATE_ASSIGN_SELF=always assigns new issues to the current account.
-- env --
LINEAR_ISSUE_CREATE_ASSIGN_SELF=always
-- run --
linear issue create --title "Assigned by config" --team ENG --no-interactive
