body
-- run --
linear issue create --json --title 'Valid title' --priority 2 --assignee ''
-- stdout.json --
{
  "ok": false,
  "effect": "none",
  "error": {
    "code": "ValidationError",
    "message": "User reference cannot be empty"
  }
}
-- exit --
1
