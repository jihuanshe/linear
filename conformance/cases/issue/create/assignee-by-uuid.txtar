An assignee given as a UUID (any case) is looked up and used instead of the default self-assignment.
-- seed.json --
{"User": [{"id": "abcdef01-2345-4678-9abc-def012345678", "name": "Jane Developer", "displayName": "jane"}]}
-- env --
LINEAR_ISSUE_CREATE_ASSIGN_SELF=always
-- run --
linear issue create --title "Assigned by UUID" --team ENG --assignee ABCDEF01-2345-4678-9ABC-DEF012345678 --no-interactive --json
