A state change made while the closing context is read is noticed by the final read, so the protected close writes nothing.
-- seed.json --
{"Issue": [{"id": "1a000000-0000-4000-8000-000000000123", "identifier": "ENG-123", "title": "Closing", "state": "0d000000-0000-4000-8000-000000000002"}]}
-- run --
linear issue view ENG-123 --json > original.json
-- faults.json --
[{"on": "query", "selects": "history", "action": "patch-after", "seed": {"Issue": [{"id": "1a000000-0000-4000-8000-000000000123", "state": "0d000000-0000-4000-8000-000000000005"}]}}]
-- run --
linear issue update ENG-123 --state Canceled --base-file original.json --json
