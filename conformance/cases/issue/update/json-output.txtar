--json prints exactly one write result whose data is the mutation payload, including the resulting priority and labels.
-- seed.json --
{"Issue": [{"id": "1a000000-0000-4000-8000-000000000123", "identifier": "ENG-123", "title": "Existing issue", "state": "0d000000-0000-4000-8000-000000000002", "labels": ["0e000000-0000-4000-8000-000000000002"]}]}
-- run --
linear issue update --unprotected ENG-123 --priority 2 --json
