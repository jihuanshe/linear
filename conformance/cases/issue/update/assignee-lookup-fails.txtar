{
  "ok": false,
  "effect": "none",
  "error": {
    "code": "Error",
    "message": "Failed to update issue: User lookup unavailable",
    "details": {
      "errors": [
        {
          "message": "User lookup unavailable"
        }
      ]
    }
  }
}
