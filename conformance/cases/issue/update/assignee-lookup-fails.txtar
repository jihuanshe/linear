{"User": [{"id": "abcdef01-2345-4678-9abc-def012345678", "name": "Jane Developer", "displayName": "jane"}], "Issue": [{"id": "1a000000-0000-4000-8000-000000000123", "identifier": "ENG-123", "title": "Existing issue", "state": "0d000000-0000-4000-8000-000000000002"}]}
-- faults.json --
[{"on": "query:users", "action": "status", "status": 200, "body": {"data": null, "errors": [{"message": "User lookup unavailable"}]}}]
-- run --
linear issue update --unprotected ENG-123 --assignee abcdef01-2345-4678-9abc-def012345678 --json
