Sub-issues and comments come back in the order Linear returns them; this calibrates the fake's default connection order.

live: true
-- run --
linear issue create --team {{TEAM}} --title "{{RUN}} order parent" --json
-- stdout.json --
{"ok": true, "effect": "applied", "data": {"success": true, "issue": {"identifier": "{{=PARENT}}", "...": true}}, "fields": "{{*}}"}
-- stderr --
{{*}}
-- run --
linear issue create --team {{TEAM}} --title "{{RUN}} order child one" --parent {{PARENT}} --json
-- stdout.json --
{"ok": true, "effect": "applied", "data": {"success": true, "issue": {"identifier": "{{=CHILD1}}", "...": true}}, "fields": "{{*}}"}
-- run --
linear issue create --team {{TEAM}} --title "{{RUN}} order child two" --parent {{PARENT}} --json
-- stdout.json --
{"ok": true, "effect": "applied", "data": {"success": true, "issue": {"identifier": "{{=CHILD2}}", "...": true}}, "fields": "{{*}}"}
-- run --
linear issue comment add {{PARENT}} --body "first comment" --json
-- stdout.json --
{"...": true, "ok": true}
-- run --
linear issue comment add {{PARENT}} --body "second comment" --json
-- stdout.json --
{"...": true, "ok": true}
-- run --
linear issue view {{PARENT}}
