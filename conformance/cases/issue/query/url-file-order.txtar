--url-file returns one lookup per URL, in input order, each with its own matches.
-- seed.json --
{"Issue": [
  {"identifier": "ENG-1", "title": "Both", "description": "来源：https://example.com/second\nhttps://example.com/first"},
  {"identifier": "ENG-2", "title": "Only first", "description": "https://example.com/first"}]}
-- file urls.txt --
https://example.com/second
https://example.com/first
-- run --
linear issue query --all-teams --url-file urls.txt --limit 1 --json
