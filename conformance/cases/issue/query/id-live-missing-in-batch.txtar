--id reads a batch where one identifier does not exist: the others are still returned and the missing one is reported, on Linear and on the fake alike.

live: true
-- run --
linear issue create --team {{TEAM}} --title "{{RUN}} id batch" --json
-- stdout.json --
{"ok": true, "effect": "applied", "data": {"success": true, "issue": {"identifier": "{{=ISSUE}}", "...": true}}, "fields": "{{*}}"}
-- stderr --
{{*}}
-- run --
linear issue query --id {{ISSUE}} --id ENG-999999 --json
-- stdout.json --
{"nodes": [{"identifier": "{{ISSUE}}", "...": true}], "pageInfo": {"hasNextPage": false, "endCursor": null}, "resolutions": [{"status": "found", "requested": "{{ISSUE}}", "identifier": "{{ISSUE}}"}, {"status": "not_found", "requested": "ENG-999999"}], "reconciliation": {"requested": 2, "read": 1, "missing": 1}}
-- cleanup --
linear issue delete {{ISSUE}} -y
