Without --team, URL mode searches the whole workspace and ignores the configured default team; --team narrows it and explains why a resolved issue was excluded.
-- seed.json --
{"Issue": [{"id": "1a000000-0000-4000-8000-000000000101", "identifier": "ENG-101", "title": "Fix login bug", "previousIdentifiers": ["OLD-7"]}]}
-- env --
LINEAR_TEAM_KEY=P38IT
-- run --
linear issue query --url https://linear.app/kadoraba/issue/ENG-101 --json
