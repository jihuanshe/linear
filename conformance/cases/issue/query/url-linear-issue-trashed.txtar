A trashed issue's URL resolves as trashed; it appears in nodes only with --include-archived.
-- seed.json --
{"Issue": [{"identifier": "ENG-101", "title": "Fix login bug", "trashed": true, "archivedAt": "2025-09-24T00:00:00.000Z"}]}
-- run --
linear issue query --all-teams --url https://linear.app/kadoraba/issue/ENG-101 --json
-- stdout.json --
{
  "nodes": [],
  "pageInfo": {
    "hasNextPage": false,
    "endCursor": null
  },
  "resolution": {
    "status": "trashed",
    "requested": "ENG-101",
    "identifier": "ENG-101"
  }
}
-- run --
linear issue query --all-teams --url https://linear.app/kadoraba/issue/ENG-101 --include-archived --json
-- stdout.json --
