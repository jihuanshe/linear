An invalid or non-ISO LINEAR_NOW fails every command, even one that shows no relative dates, instead of silently using the real clock or the local time zone.
-- seed.json --
{"Issue": [{"identifier": "ENG-1", "title": "Any"}]}
-- env --
LINEAR_NOW=yesterday
-- run --
linear issue query --team ENG --no-pager
-- stderr --
✗ LINEAR_NOW is not a valid date: yesterday
  Set an ISO 8601 instant such as 2026-01-01T00:00:00Z, or unset it.
-- exit --
1
-- env --
LINEAR_NOW=10/11/2026
-- run --
linear issue query --team ENG --no-pager
-- stderr --
✗ LINEAR_NOW is not a valid date: 10/11/2026
  Set an ISO 8601 instant such as 2026-01-01T00:00:00Z, or unset it.
-- exit --
1
-- run --
linear issue view ENG-1 --json
-- stdout.json --
{
  "ok": false,
  "effect": "none",
  "error": {
    "code": "ValidationError",
    "message": "LINEAR_NOW is not a valid date: 10/11/2026",
    "suggestion": "Set an ISO 8601 instant such as 2026-01-01T00:00:00Z, or unset it."
  }
}
-- exit --
1
-- no-requests --
