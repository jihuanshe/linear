URL mode keeps reading candidate pages until the exact match is found, past more than a page of near misses.
-- seed.json --
{"Issue": [
  {"identifier": "ENG-1", "title": "Exact", "description": "https://example.com/objects/42", "createdAt": "2024-01-01T00:00:00.000Z"},
  {"$repeat": 120, "identifier": "ENG-{{n:3}}", "number": 0, "title": "Near miss {{n}}", "description": "https://example.com/objects/42/other"}]}
-- run --
linear issue query --all-teams --url https://example.com/objects/42 --json
-- stdout.json --
