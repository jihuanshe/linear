--url with --cycle resolves the cycle in the configured default team and keeps that team as a filter.
-- seed.json --
{"Team": [{"id": "0c000000-0000-4000-8000-000000000001", "cyclesEnabled": true}],
 "Cycle": [{"id": "1d000000-0000-4000-8000-000000000006", "team": "0c000000-0000-4000-8000-000000000001", "number": 6, "name": "Sprint 6", "startsAt": "2025-12-25T00:00:00.000Z", "endsAt": "2026-01-08T00:00:00.000Z"}],
 "Issue": [
  {"identifier": "ENG-1", "title": "In cycle", "description": "https://example.com/objects/42", "cycle": "1d000000-0000-4000-8000-000000000006"},
  {"identifier": "ENG-2", "title": "Not in cycle", "description": "https://example.com/objects/42"},
  {"identifier": "P38IT-1", "title": "Other team", "team": "0c000000-0000-4000-8000-000000000038", "state": "0d000000-0000-4000-8000-000000000381", "description": "https://example.com/objects/42"}]}
-- env --
LINEAR_TEAM_KEY=ENG
-- run --
linear issue query --url https://example.com/objects/42 --cycle 6 --json
