--id reads issues across teams in request order, reading duplicates once, and resolves moved, trashed, archived and missing identifiers without failing the batch; people get the resolutions and the reconciliation.
-- seed.json --
{"Issue": [
  {"identifier": "ENG-101", "title": "Found"},
  {"identifier": "ENG-102", "title": "Trashed", "trashed": true, "archivedAt": "2025-09-24T00:00:00.000Z"},
  {"identifier": "ENG-103", "title": "Archived", "archivedAt": "2025-09-20T00:00:00.000Z"},
  {"identifier": "ENG-150", "title": "Moved", "previousIdentifiers": ["OLD-7"]},
  {"identifier": "P38IT-984", "title": "Other team", "team": "0c000000-0000-4000-8000-000000000038", "state": "0d000000-0000-4000-8000-000000000381"}]}
-- run --
linear issue query --id eng-101 --id P38IT-984 --id ENG-101 --json
