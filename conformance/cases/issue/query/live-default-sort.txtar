The default query order puts active states before closed ones, then higher priority first with no priority last; this calibrates the fake's issue sort against Linear.

live: true
-- run --
linear label create --name "{{RUN}}-sort" --team {{TEAM}} --color "#888888" --json
-- stdout.json --
{"ok": true, "effect": "applied", "data": {"issueLabel": {"id": "{{=LABEL}}", "name": "{{RUN}}-sort", "...": true}}}
-- run --
linear issue create --team {{TEAM}} --title "{{RUN}} done-urgent" --state "Done" --priority urgent --label "{{RUN}}-sort" --json
-- stdout.json --
{"ok": true, "effect": "applied", "data": {"success": true, "issue": {"identifier": "{{=I1}}", "...": true}}, "fields": "{{*}}"}
-- stderr --
{{*}}
